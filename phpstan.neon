# The extension registers vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
# and its own bootstrap (ABSPATH, WP_DEBUG, ...) automatically, so neither is
# listed here.
includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	# Makes PHPStan understand expect(), it(), describe() and type checks the
	# tests themselves. Every rule it registers inspects a test file, so the
	# `tests` entry in `paths` below is what gives those rules a target: with
	# the extension alone and no test file in `paths` it does nothing at all.
	- vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
	level: 10
	phpVersion: 80100
	paths:
		- admin-suite.php
		- uninstall.php
		- includes
		- tests
	bootstrapFiles:
		- phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: true
	reportUnmatchedIgnoredErrors: true
